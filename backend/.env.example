# AegisAML Backend Environment Configuration
# Copy this file to .env and configure for your environment

# PostgreSQL Database Connection
# Option A: Full Connection URL (Neon, Render, Supabase, AWS RDS, Railway, Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_aml

# Option B: Individual connection parameters (fallback if DATABASE_URL is unset)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aegis_aml

# Authentication Security (Min 32 characters random secret for HMAC/JWT signing)
AEGIS_SECRET_KEY=change_this_to_a_secure_random_key_min_32_chars

# CORS and Frontend URL configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
