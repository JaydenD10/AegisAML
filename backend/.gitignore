# ==========================================
# AegisAML Backend .gitignore
# ==========================================

# Bytecode & Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
*.log

# Editor & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
