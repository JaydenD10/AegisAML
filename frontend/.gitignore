# ==========================================
# AegisAML Frontend .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build & Outputs
/.next/
/out/
/build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing & Logs
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env*.local
.env.*
!.env.example

# OS & Misc
.DS_Store
Thumbs.db
*.pem
*.key
